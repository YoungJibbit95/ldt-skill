---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import OrbitMark from '../components/OrbitMark.astro';
import { base, pathFor, repository, otherLocale, translatedPath, type Locale } from '../lib/site';
interface Props { locale: Locale; title: string; description: string; noindex?: boolean }
const { locale, title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const de = locale === 'de';
---
<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
    <title>{title}</title><meta name="description" content={description} />
    <meta name="theme-color" content="#090b18" /><link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    {noindex ? <meta name="robots" content="noindex" /> : <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang={locale} href={canonical} />
      <link rel="alternate" hreflang={otherLocale(locale)} href={new URL(translatedPath(Astro.url.pathname, locale), Astro.site)} />
    </>}
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#main">{de ? 'Zum Inhalt' : 'Skip to content'}</a>
    <header class="landing-header"><SiteHeader locale={locale} /></header>
    <main id="main"><slot /></main>
    <footer class="site-footer site-container">
      <div><a class="brand" href={pathFor(locale)}><OrbitMark /><span>LittleDevTeam<span class="brand-dot">.</span></span></a><p>{de ? 'Große Ideen. Klare nächste Schritte.' : 'Big ideas. Clear next steps.'}</p></div>
      <div class="footer-links"><a href={pathFor(locale, 'docs')}>{de ? 'Dokumentation' : 'Documentation'}</a><a href={pathFor(locale, 'built-with-littledevteam')}>{de ? 'Entstehung' : 'Built with LDT'}</a><a href={repository}>GitHub ↗</a></div>
      <p class="footer-note">{de ? 'Mit LittleDevTeam entwickelt. Öffentlich nachvollziehbar.' : 'Built with LittleDevTeam. Openly documented.'}<br /><span>{de ? 'Entwicklungsstand · Native Codex Skill' : 'Development snapshot · Native Codex skill'}</span></p>
    </footer>
  </body>
</html>
