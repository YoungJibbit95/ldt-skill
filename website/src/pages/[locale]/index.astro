---
import Page from '../../layouts/Page.astro';
import OrbitMark from '../../components/OrbitMark.astro';
import { pathFor, type Locale } from '../../lib/site';
export function getStaticPaths() { return [{ params: { locale: 'de' } }, { params: { locale: 'en' } }]; }
const locale = Astro.params.locale as Locale;
const de = locale === 'de';
const t = de ? {
  title: 'LittleDevTeam — Große Ideen. Klare nächste Schritte.',
  description: 'Ein Skill für Codex: von der Idee über eine freigegebene Architektur bis zum geprüften Meilenstein. Mit klaren Aufgaben und nachvollziehbaren Ergebnissen.',
  pill: 'Dein Coding-Agent. Mit einem Plan.',
  heading: ['Große Ideen.', 'Klare nächste', 'Schritte.'],
  intro: 'LittleDevTeam ist ein Skill für Codex. Er führt deinen Agenten von der Idee über einen konkreten Architekturvorschlag bis zum geprüften Meilenstein. Du entscheidest über Vorschlag und Ergebnis.',
  start: 'Quickstart öffnen', explore: 'Workflow entdecken', note: 'Native Codex Skill · Python-Tools ohne externe Abhängigkeiten',
  preview: 'ILLUSTRATIVES WORKFLOW-BEISPIEL', task: 'Baue eine moderne Dokumentationswebsite.',
  architecture: 'Architektur vor Umsetzung.', proposal: 'Ein Vorschlag, den du beurteilen kannst.',
  stepLabel: 'NÄCHSTER SCHRITT', approval: 'Deine Entscheidung', approvalText: 'Vorschlag lesen. Anpassen. Freigeben.',
  mini: ['Umfang geklärt', 'Architektur vorgeschlagen', 'Umsetzung nach Freigabe'],
  strip: ['Erst verstehen.', 'Bewusst entscheiden.', 'Schritt für Schritt bauen.'],
  promiseLabel: 'MEHR KLARHEIT. WENIGER UMWEGE.', promiseTitle: 'Eine Idee ist ein Anfang.', promiseEnd: 'Ein Workflow macht sie greifbar.',
  features: [
    ['01', 'Erst der Plan.', 'Der Skill untersucht dein Projekt, klärt Anforderungen und macht Architekturentscheidungen sichtbar, bevor die Umsetzung beginnt.'],
    ['02', 'Du entscheidest.', 'Freigaben beziehen sich auf konkrete Vorschläge und Ergebnisse. Der nächste Schritt bleibt nachvollziehbar.'],
    ['03', 'Mit Nachweisen.', 'Prüfungen, Review und Projektgedächtnis halten fest, was tatsächlich gemacht wurde — und was noch offen ist.'],
  ],
  workflowLabel: 'VON DER IDEE ZUM ERGEBNIS', workflowTitle: 'Ein klarer Weg durch dein Projekt.', workflowText: 'Der Intake erfasst Auftrag und Bestand. Bei komplexen Fragen kann ein Architektur-Lead begrenzte Research-Aufträge vergeben, die Ergebnisse integrieren und daraus Projektansicht sowie Task-Verträge für die Umsetzung ableiten. Echte Agenten laufen über die verfügbare Harness-Laufzeit.',
  steps: [['Verstehen', 'Auftrag, Regeln & Arbeitsstand'], ['Planen', 'Research & Architektur'], ['Entscheiden', 'Architektur und Start freigeben'], ['Entwickeln', 'Vertraglich umrissener Meilenstein'], ['Prüfen', 'Checks, Review & Integration'], ['Weitergehen', 'Ergebnis bewerten & fortsetzen']],
  guide: 'Zum praktischen Guide',
  builtLabel: 'DIESE WEBSITE IST DAS BEISPIEL.', builtTitle: 'Mit LittleDevTeam.', builtEnd: 'Für LittleDevTeam.',
  builtText: 'Diese Website entsteht mit LittleDevTeam: vom freigegebenen Plan über den Einstieg bis zu Referenz, Suche und Simulation. W1 und W2 wurden geprüft und vom Benutzer freigegeben. Die Fallstudie zeigt die zugehörigen Commits und CI-Läufe und kennzeichnet die Reviews als Eigenprüfungen.',
  builtLink: 'Die echte Entstehungsgeschichte',
  finalLabel: 'DEIN NÄCHSTES PROJEKT WARTET.', finalTitle: 'Eine Idee hast du schon?', finalText: 'Starte den Quickstart in deinem Projekt. Der Agent richtet den GitHub-Stand ein, untersucht den Bestand und erstellt einen ersten überprüfbaren Vorschlag.',
  finalButton: 'Quickstart öffnen', finalSecondary: 'Erst die Dokumentation lesen',
} : {
  title: 'LittleDevTeam — Big ideas. Clear next steps.',
  description: 'A skill for Codex: from an idea through approved architecture to a verified milestone. Clear tasks, decisions, and evidence.',
  pill: 'Your coding agent. With a plan.',
  heading: ['Big ideas.', 'Clear next', 'steps.'],
  intro: 'LittleDevTeam is a skill for Codex. It guides your agent from an idea through a concrete architecture proposal to a verified milestone. You decide on the proposal and the result.',
  start: 'Open the quick start', explore: 'Explore the workflow', note: 'Native Codex skill · Python tools with no external dependencies',
  preview: 'ILLUSTRATIVE WORKFLOW EXAMPLE', task: 'Build a modern documentation website.',
  architecture: 'Architecture before implementation.', proposal: 'A proposal you can actually evaluate.',
  stepLabel: 'NEXT STEP', approval: 'Your decision', approvalText: 'Read the proposal. Revise. Approve.',
  mini: ['Scope understood', 'Architecture proposed', 'Implementation after approval'],
  strip: ['Understand first.', 'Decide deliberately.', 'Build step by step.'],
  promiseLabel: 'MORE CLARITY. FEWER DETOURS.', promiseTitle: 'An idea is a beginning.', promiseEnd: 'A workflow makes it tangible.',
  features: [
    ['01', 'Plan first.', 'The skill inspects your project, clarifies requirements, and makes architecture decisions visible before implementation starts.'],
    ['02', 'You decide.', 'Approvals refer to concrete proposals and results. The next step stays understandable and intentional.'],
    ['03', 'Show the evidence.', 'Checks, review, and project memory record what actually happened — and what remains unresolved.'],
  ],
  workflowLabel: 'FROM IDEA TO RESULT', workflowTitle: 'A clear path through your project.', workflowText: 'Intake records the request and current state. For complex questions, an architecture lead can assign bounded research, integrate its results, and use a project view and task contracts to prepare implementation. Real agents run through the available harness.',
  steps: [['Understand', 'Request, rules & working state'], ['Plan', 'Research & architecture'], ['Decide', 'Approve architecture and start'], ['Build', 'Contract-bounded milestone'], ['Verify', 'Checks, review & integration'], ['Continue', 'Evaluate the result & iterate']],
  guide: 'Open the practical guide',
  builtLabel: 'THIS WEBSITE IS THE EXAMPLE.', builtTitle: 'Built with LittleDevTeam.', builtEnd: 'For LittleDevTeam.',
  builtText: 'We build this website with LittleDevTeam: from an approved plan and the entry experience to reference, search, and simulation. W1 and W2 were checked and approved by the user. The case study links their commits and CI runs and identifies the reviews as self-reviews.',
  builtLink: 'Read the actual project story',
  finalLabel: 'YOUR NEXT PROJECT IS WAITING.', finalTitle: 'Already have an idea?', finalText: 'Start the quick setup in your project. The agent retrieves the GitHub version, inspects the current state, and prepares a first proposal you can evaluate.',
  finalButton: 'Open the quick start', finalSecondary: 'Read the documentation first',
};
---
<Page locale={locale} title={t.title} description={t.description}>
  <section class="hero">
    <div class="nebula" aria-hidden="true"></div><div class="star-field" aria-hidden="true"></div>
    <div class="hero-orbit" aria-hidden="true"><span></span></div>
    <div class="site-container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow-pill"><span class="status-spark" aria-hidden="true"></span>{t.pill}<span class="pill-line" aria-hidden="true"></span><span class="pill-tag">LDT</span></div>
        <h1>{t.heading[0]}<br />{t.heading[1]}<br /><span class="gradient-text">{t.heading[2]}</span></h1>
        <p class="hero-intro">{t.intro}</p>
        <div class="hero-buttons"><a class="button" href={pathFor(locale, 'docs/guide')}>{t.start}<span aria-hidden="true">↗</span></a><a class="button button-ghost" href={pathFor(locale, 'demo')}>{t.explore}<span aria-hidden="true">↓</span></a></div>
        <p class="hero-note"><svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 2 3 5v5c0 4 7 8 7 8s7-4 7-8V5l-7-3Z" stroke="currentColor"/><path d="m6 10 3 3 5-6" stroke="currentColor"/></svg>{t.note}</p>
      </div>
      <div class="mission-scene">
        <div class="scene-coordinates" aria-hidden="true">LDT / MISSION 001<span>51° N · 013° E</span></div>
        <div class="mission-panel">
          <div class="panel-bar"><span><span class="window-dot"></span><span class="window-dot"></span><span class="window-dot"></span></span><span>littledevteam / workspace</span><span class="profile-badge">BALANCED</span></div>
          <div class="mission-content">
            <div class="mission-command"><span class="command-chevron">›</span><code>$architect-dev-team</code></div>
            <p class="mission-task">{t.task}</p>
            <div class="mission-plan"><div class="mission-icon"><OrbitMark /></div><div><h2>{t.architecture}</h2><p>{t.proposal}</p></div><span class="plan-arrow" aria-hidden="true">↗</span></div>
            <div class="mission-trail">{t.mini.map((item, i) => <div><span class:list={['trail-dot', { active: i === 1 }]} aria-hidden="true">{i === 0 ? '✓' : i === 1 ? '◉' : '·'}</span><span>{item}</span><span class="trail-count" aria-hidden="true">0{i + 1}</span></div>)}</div>
            <div class="decision-card"><span class="small-label">{t.stepLabel}</span><div><strong>{t.approval}</strong><span class="decision-orbit" aria-hidden="true">✧</span></div><p>{t.approvalText}</p></div>
          </div>
          <div class="panel-footer"><span class="status-spark" aria-hidden="true"></span>{t.preview}</div>
        </div>
        <div class="floating-label" aria-hidden="true"><span>✧</span>architecture first<span class="label-line"></span></div>
      </div>
    </div>
  </section>
  <div class="principles-strip site-container">{t.strip.map((text, i) => <div><span>0{i + 1}</span><p>{text}</p><span class="strip-star" aria-hidden="true">✧</span></div>)}</div>
  <section class="promise-section site-container section-space">
    <p class="small-label section-label">{t.promiseLabel}</p><h2 class="section-heading">{t.promiseTitle}<br /><span class="muted-heading">{t.promiseEnd}</span></h2>
    <div class="feature-grid">{t.features.map(([n, title, text]) => <article class="feature"><span class="feature-number">{n}<span aria-hidden="true"> /</span></span><h3>{title}</h3><p>{text}</p></article>)}</div>
  </section>
  <section id="workflow" class="workflow-section section-space">
    <div class="site-container"><div class="section-split"><div><p class="small-label section-label">{t.workflowLabel}</p><h2 class="section-heading">{t.workflowTitle}</h2></div><p>{t.workflowText}</p></div>
      <ol class="workflow-grid">{t.steps.map(([title, text], i) => <li><span class="workflow-index">0{i + 1}</span><span class="workflow-line" aria-hidden="true"></span><h3>{title}</h3><p>{text}</p></li>)}</ol>
      <a class="text-link" href={pathFor(locale, 'docs/guide')}>{t.guide}<span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="built-section site-container section-space"><div class="built-visual" aria-hidden="true"><div class="built-ring ring-a"></div><div class="built-ring ring-b"></div><div class="built-ring ring-c"></div><div class="built-symbol"><OrbitMark /></div><span class="orbit-point point-a"></span><span class="orbit-point point-b"></span><span class="orbit-text">BUILT WITH THE WORKFLOW</span></div><div><p class="small-label section-label">{t.builtLabel}</p><h2 class="section-heading">{t.builtTitle}<br /><span class="muted-heading">{t.builtEnd}</span></h2><p class="body-copy">{t.builtText}</p><a class="text-link" href={pathFor(locale, 'built-with-littledevteam')}>{t.builtLink}<span aria-hidden="true">↗</span></a></div></section>
  <section class="final-section site-container"><div class="final-glow" aria-hidden="true"></div><p class="small-label section-label">{t.finalLabel}</p><h2>{t.finalTitle}</h2><p>{t.finalText}</p><div class="hero-buttons"><a class="button" href={pathFor(locale, 'docs/guide')}>{t.finalButton}<span aria-hidden="true">↗</span></a><a class="text-link" href={pathFor(locale, 'docs')}>{t.finalSecondary}<span aria-hidden="true">→</span></a></div></section>
</Page>
