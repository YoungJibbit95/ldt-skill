---
import Page from '../../layouts/Page.astro';
import { pathFor, repository, type Locale } from '../../lib/site';
import '../../styles/demo.css';
export function getStaticPaths() { return ['de', 'en'].map(locale => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const de = locale === 'de';
const events = de ? [
  { phase: '01 / AUFTRAG', title: 'Ein Skill erklärt sich an einem echten Projekt.', body: 'Der Auftrag: eine moderne Website mit Dokumentation, Guide und Installation. Zusätzlich soll sie ausdrücklich zeigen, dass LittleDevTeam selbst für ihre Entwicklung verwendet wird. Der Projektbrief hält diesen Zweck fest.', links: [['Projektbrief am veröffentlichten Stand', `${repository}/blob/9a062eb9de0990ce1074dd677d26e5a528ee14a0/docs/website-brief.md`]] },
  { phase: '02 / PLANUNG', title: 'Gestaltung und Architektur gemeinsam festlegen.', body: 'Festgelegt wurden Deutsch und Englisch, ein ruhiger Nebula-Look, GitHub Pages und eine erklärende Simulation. Der Architekturplan trennt Einstieg (W1), Vertiefung (W2) und Veröffentlichung (W3). Der Benutzer gab diesen konkreten Plan im Gespräch zur Umsetzung frei.', links: [['Website-Plan in W1', `${repository}/blob/aec5fac9d1429201b88f1f22022af8b4a2cf4022/docs/website-plan.md`]] },
  { phase: '03 / W1', title: 'Einen nutzbaren Einstieg umsetzen.', body: 'W1 liefert die zweisprachige Startseite, Installation und den ersten Guide. Ein eigener Git-Worktree schützt den laufenden Skill-Arbeitsstrang. Der Website-Commit verändert keine Skill-Implementierung. Der zunächst als Draft eröffnete PR macht die Änderungen überprüfbar.', links: [['W1-Commit aec5fac', `${repository}/commit/aec5fac9d1429201b88f1f22022af8b4a2cf4022`], ['PR #1', `${repository}/pull/1`]] },
  { phase: '04 / PRÜFUNG', title: 'Ergebnisse mit echten Nachweisen verbinden.', body: 'Für W1 bestehen Produktionsbuild, Typprüfung, 361 interne Link-/Asset-/Ankerprüfungen und zehn Browsertests. Diese prüfen beide Sprachen bei 375, 768 und 1440 Pixeln, Tastaturnavigation, Kopieren, reduzierte Bewegung und Axe auf acht Seiten. Auch die bestehende Skill-CI besteht. Der Review war eine Eigenprüfung.', links: [['Website-CI für aec5fac', `${repository}/actions/runs/39155769109`], ['Skill-CI für aec5fac', `${repository}/actions/runs/39155769105`]] },
  { phase: '05 / W2', title: 'Referenz und Demonstration abschließen.', body: 'Nach der W1-Freigabe entstanden die vollständige DE/EN-Referenz, die lokalisierte Suche, die Workflow-Simulation und diese Fallstudie. W2 besteht mit 19 Browsertests, 1.087 internen Link-/Asset-/Ankerprüfungen, Typprüfung und Build. Axe meldet keine schwerwiegenden oder kritischen Befunde; Installations-Smokes bestehen auf Windows, macOS und Linux. Website- und Skill-CI sind am Commit db71e83 erfolgreich. Der Benutzer hat diesen W2-Stand im Gespräch freigegeben. Der Review bleibt eine Eigenprüfung; die späteren W3-Planungsagenten haben W2 nicht nachträglich unabhängig geprüft.', links: [['W2-Commit db71e83', `${repository}/commit/db71e831f3345767282bf12ffd47c9898ab6aca9`], ['PR #2', `${repository}/pull/2`], ['Website-CI für db71e83', `${repository}/actions/runs/39158216573`], ['Skill-CI für db71e83', `${repository}/actions/runs/39158216578`]] },
] : [
  { phase: '01 / REQUEST', title: 'A skill explains itself through a real project.', body: 'The task: a modern website with documentation, a guide, and installation instructions. It must also explicitly show that LittleDevTeam is used to build it. The project brief records that purpose.', links: [['Published project brief', `${repository}/blob/9a062eb9de0990ce1074dd677d26e5a528ee14a0/docs/website-brief.md`]] },
  { phase: '02 / PLANNING', title: 'Agree on design and architecture together.', body: 'Decisions covered German and English, a calm Nebula design, GitHub Pages, and an explanatory simulation. The architecture separates entry (W1), deeper functionality (W2), and publication (W3). The user explicitly approved that concrete plan in the conversation.', links: [['Website plan in W1', `${repository}/blob/aec5fac9d1429201b88f1f22022af8b4a2cf4022/docs/website-plan.md`]] },
  { phase: '03 / W1', title: 'Implement one usable entry experience.', body: 'W1 delivers the bilingual homepage, installation, and first guide. A separate Git worktree protects ongoing skill development. The website commit does not change the skill implementation. The PR, initially opened as a draft, makes the changes inspectable.', links: [['W1 commit aec5fac', `${repository}/commit/aec5fac9d1429201b88f1f22022af8b4a2cf4022`], ['PR #1', `${repository}/pull/1`]] },
  { phase: '04 / VERIFICATION', title: 'Connect outcomes to actual evidence.', body: 'W1 passes production build, type checking, 361 internal link/asset/anchor checks, and ten browser tests. They cover both languages at 375, 768, and 1440 pixels, keyboard navigation, copying, reduced motion, and axe across eight pages. Existing skill CI also passes. Review was self-review.', links: [['Website CI for aec5fac', `${repository}/actions/runs/39155769109`], ['Skill CI for aec5fac', `${repository}/actions/runs/39155769105`]] },
  { phase: '05 / W2', title: 'Complete the reference and demonstration.', body: 'After W1 approval, W2 added the full DE/EN reference, localized search, workflow simulation, and this case study. W2 passes 19 browser tests, 1,087 internal link/asset/anchor checks, type checking, and production build. Axe reports no serious or critical findings; installation smokes pass on Windows, macOS, and Linux. Website and skill CI pass at commit db71e83. The user approved that W2 revision in the conversation. Review remains self-review; the later W3 planning agents did not independently review W2 after the fact.', links: [['W2 commit db71e83', `${repository}/commit/db71e831f3345767282bf12ffd47c9898ab6aca9`], ['PR #2', `${repository}/pull/2`], ['Website CI for db71e83', `${repository}/actions/runs/39158216573`], ['Skill CI for db71e83', `${repository}/actions/runs/39158216578`]] },
];
---
<Page locale={locale} title={`${de ? 'Mit LittleDevTeam gebaut' : 'Built with LittleDevTeam'} — LittleDevTeam`} description={de ? 'Die tatsächliche Entstehung dieser Website: Auftrag, Plan, freigegebene Meilensteine und echte Prüfergebnisse.' : 'The actual story of this website: request, plan, approved milestones, and real verification evidence.'}>
  <article class="case-page site-container section-space" data-pagefind-body>
    <p class="small-label section-label">{de ? 'DAS PROJEKT HINTER DIESER WEBSITE' : 'THE PROJECT BEHIND THIS WEBSITE'} · 18 OCT 2026</p>
    <h1>{de ? 'Mit LittleDevTeam gebaut. Und nachvollziehbar dokumentiert.' : 'Built with LittleDevTeam. Documented along the way.'}</h1>
    <p class="case-lead">{de ? 'Diese Website ist zugleich das Demonstrationsprojekt des Skills. Hier stehen tatsächliche Entscheidungen und öffentlich überprüfbare Artefakte — getrennt von der illustrativen Workflow-Demo.' : 'This website is also the skill’s demonstration project. These are actual decisions and publicly inspectable artifacts, separate from the illustrative workflow demo.'}</p>
    <ol class="case-timeline">{events.map(event => <li><p class="small-label">{event.phase}</p><h2>{event.title}</h2><p>{event.body}</p><div class="case-evidence">{event.links.map(([label, href]) => <a class="text-link" href={href}>{label} ↗</a>)}</div></li>)}</ol>
    <section class="case-section"><h2>{de ? 'Was diese Belege aussagen' : 'What this evidence establishes'}</h2><p>{de ? 'Commits und CI-Läufe sind an konkrete Quellstände gebunden. Ein grüner Testlauf beweist die geprüften Szenarien, keine universelle Fehlerfreiheit. Die hier redaktionell zusammengefassten menschlichen Entscheidungen wurden im Gespräch getroffen; diese Seite authentifiziert sie nicht.' : 'Commits and CI runs refer to concrete source revisions. Passing tests establish the exercised scenarios, not universal correctness. Human decisions summarized here were made in the conversation; this page does not authenticate them.'}</p><p>{de ? 'Private Zustandsdateien und Freigabeprotokolle werden nicht automatisch importiert. Alle Beispiele in der Demo bleiben Simulationen. Für W1 und W2 wird kein unabhängiger Review behauptet. Die Installations-Smokes prüfen Dateien und Python-Helfer, nicht die tatsächliche Erkennung durch Codex. Geschwindigkeitsgewinne wurden nicht gemessen.' : 'Private state files and approval logs are not automatically imported. Demo examples remain simulations. No independent review is claimed for W1 or W2. Installation smokes check files and Python helpers, not actual skill discovery by Codex. Productivity gains have not been measured.'}</p></section>
    <section class="case-section"><h2>{de ? 'Noch auf dem Weg zur Veröffentlichung' : 'Still on the path to publication'}</h2><p>{de ? 'Die W2-Ergebnisfreigabe erlaubt weder Merge noch Deployment. W3 umfasst Feinschliff, Release-Vorbereitung und abschließende Prüfungen. Lighthouse-Ergebnisse, unabhängige Reviews und die Prüfung öffentlicher URLs werden erst nach ihrer tatsächlichen Durchführung dokumentiert. Die Veröffentlichung benötigt eine eigene Freigabe. Die unterstützten Skill-Funktionen beschreibt die Referenz am benannten Entwicklungsstand.' : 'W2 result approval authorizes neither merging nor deployment. W3 covers refinement, release preparation, and final checks. Lighthouse results, independent reviews, and public URL checks will be documented after they actually run. Publication requires separate approval. The reference describes skill capabilities at a named development snapshot.'}</p><div class="hero-buttons"><a class="button" href={pathFor(locale, 'demo')}>{de ? 'Simulation entdecken' : 'Explore the simulation'} ↗</a><a class="text-link" href={pathFor(locale, 'docs/checks')}>{de ? 'Prüfbefehle verstehen' : 'Understand the validation tools'} ↗</a></div></section>
  </article>
</Page>
